{
  "name": "thundervim",
  "version": "0.3.10",
  "private": true,
  "type": "module",
  "description": "Vim keybindings for editing email in the Thunderbird compose window.",
  "author": "Matthias Endler",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:addon": "npm run build && addons-linter dist/thundervim",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run lint:addon",
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "addons-linter": "^10.7.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.6.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.1"
  }
}
