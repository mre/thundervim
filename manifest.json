{
  "manifest_version": 3,
  "name": "Thundervim",
  "version": "0.3.9",
  "description": "Vim keybindings for editing email in the Thunderbird compose window.",
  "icons": {
    "48": "assets/icons/icon-48.png",
    "96": "assets/icons/icon-96.png",
    "128": "assets/icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thundervim@endler.dev",
      "strict_min_version": "151.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["compose", "storage"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "compose_action": {
    "default_area": "maintoolbar",
    "default_title": "Thundervim",
    "default_label": "Vim",
    "default_icon": {
      "48": "assets/icons/icon-48.png",
      "96": "assets/icons/icon-96.png"
    }
  },
  "compose_scripts": [
    {
      "js": ["compose.js"],
      "css": ["statusbar.css"]
    }
  ],
  "options_ui": {
    "page": "options.html"
  }
}
